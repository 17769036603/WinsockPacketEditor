<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_SUPERUSER" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.gdoo.dhxy" />
        <package android:name="com.gdoo.xxxy2026" />
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@drawable/ic_suite"
        android:label="飘渺助手"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="com.xnas.wpe.suite.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.xnas.wpe.anlei.MainActivity" android:exported="false" />
        <activity android:name="com.xnas.wpe.mounthold.MainActivity" android:exported="false" />
        <activity android:name="com.xnas.wpe.battleloop.MainActivity" android:exported="false" />
        <activity android:name="com.xnas.wpe.battleskip.MainActivity" android:exported="false" />
        <activity android:name="com.xnas.wpe.jinchan.MainActivity" android:exported="false" />
        <activity android:name="com.xnas.wpe.battlepanel.MainActivity" android:exported="false" />

        <activity android:name="android.app.NativeActivity" android:exported="false">
            <meta-data android:name="android.app.lib_name" android:value="battle_skip_launcher" />
        </activity>
        <activity-alias
            android:name="com.xnas.wpe.suite.BattleSkipStart"
            android:targetActivity="android.app.NativeActivity"
            android:exported="false"
            android:label="战斗快进启动">
            <meta-data android:name="android.app.lib_name" android:value="battle_skip_launcher" />
        </activity-alias>
        <activity-alias
            android:name="com.xnas.wpe.suite.BattleSkipStop"
            android:targetActivity="android.app.NativeActivity"
            android:exported="false"
            android:label="战斗快进停止">
            <meta-data android:name="android.app.lib_name" android:value="battle_skip_launcher" />
        </activity-alias>

        <service
            android:name="com.xnas.wpe.anlei.AnleiService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User initiated game assistance with persistent process monitoring" />
        </service>
        <service
            android:name="com.xnas.wpe.mounthold.MountHoldService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-started Rust worker that maintains and safely restores the local role movement speed in one exact game process in the emulator." />
        </service>
        <service
            android:name="com.xnas.wpe.battleloop.BattleLoopService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User initiated battle-loop assistance with persistent process monitoring" />
        </service>
        <service
            android:name="com.xnas.wpe.jinchan.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintain a foreground game worker for user-initiated Jinchan operations" />
        </service>
        <service
            android:name="com.xnas.wpe.battlepanel.BattleOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Samples user-requested read-only battle snapshots in the background for display inside the application." />
        </service>
    </application>
</manifest>
