local cfg=__CONFIG__
local key=cfg.stateKey
local SCAN_INTERVAL_SECONDS=0.25
local LEASE_STALE_GRACE=3
local CHALLENGE_REBIND_GRACE=3
local MAP_ROTATION_COOLDOWN=5
local MAP_WAIT_SECONDS=8
local DIALOG_WAIT_SECONDS=5
local SUPPORTED_MAP_ORDER={1010,1002,1003,1016,1018}
local SUPPORTED_MAPS={[1010]=true,[1002]=true,[1003]=true,[1016]=true,[1018]=true}
local MAP_FALLBACK_NAMES={[1010]='东海渔村',[1002]='地府',[1003]='北俱芦洲',[1016]='御马监',[1018]='宝象国'}
local function clean(v)
 if v==nil then return 'unknown' end
 return tostring(v):gsub('[\r\n=]',' ')
end
local function readFile(path)
 local ok,f=pcall(io.open,path,'r')
 if not ok or not f then return nil end
 local readOk,value=pcall(f.read,f,'*a')
 pcall(f.close,f)
 if not readOk then return nil end
 return value
end
local function parseInteger(value,minimum,maximum)
 if type(value)~='string' or not value:match('^[0-9]+$') then return nil end
 local n=tonumber(value)
 if not n or n<minimum or (maximum and n>maximum) or n%1~=0 or n>9007199254740991 then return nil end
 return n
end
local function parseMaps(value,allowEmpty,anyMap)
 if type(value)~='string' then return nil end
 if value=='' then return allowEmpty and {} or nil end
 local maps={}
 local previous=0
 for token in (value..','):gmatch('(.-),') do
  if not token:match('^[1-9][0-9]*$') then return nil end
  local map=parseInteger(token,1,2147483647)
  if not map or map<=previous then return nil end
  maps[#maps+1]=map
  previous=map
 end
 return maps
end
local function selectedMapsCsv(maps)
 local values={}
 for index,map in ipairs(maps or {}) do values[index]=tostring(map) end
 return table.concat(values,',')
end
local function parseCommand(contents)
 if type(contents)~='string' then return nil end
 local values={}
 local fieldCount=0
 contents=contents:gsub('\r\n','\n')
 for line in (contents..'\n'):gmatch('(.-)\n') do
  if line~='' then
   local k,v=line:match('^([a-z]+)=([^\r\n]*)$')
   if not k or values[k]~=nil then return nil end
   if k~='sequence' and k~='mode' and k~='maps' and k~='map' then return nil end
   values[k]=v
   fieldCount=fieldCount+1
  end
 end
 if fieldCount~=4 then return nil end
 local sequence=parseInteger(values.sequence,1)
 local map=parseInteger(values.map,0,2147483647)
 local mode=values.mode
 if not sequence or not map or (mode~='scan' and mode~='run' and mode~='teleport') then return nil end
 local maps=parseMaps(values.maps,mode=='scan',mode=='teleport')
 if not maps or ((mode=='run' or mode=='teleport') and (#maps==0 or map<1)) then return nil end
 if mode=='teleport' and (#maps~=1 or maps[1]~=map) then return nil end
 return {sequence=sequence,mode=mode,maps=maps,selectedMap=maps[1] or 0,map=map}
end
local function sameCommand(a,b)
 if not a or not b or a.sequence~=b.sequence or a.mode~=b.mode or a.map~=b.map then return false end
 if #(a.maps or {})~=#(b.maps or {}) then return false end
 for index,map in ipairs(a.maps or {}) do if map~=(b.maps or {})[index] then return false end end
 return true
end
local function writeBinding(s,cleared)
 local ok,f=pcall(io.open,cfg.bindingPath,'w')
 if not ok or not f then s.bindingCleared=false;return false end
 local text=''
 if not cleared then
  text='runId='..clean(cfg.runId)..'\nplayer='..clean(s.role)..'\nmanager='..clean(s.manager)..'\n'
 end
 local writeOk=pcall(f.write,f,text)
 pcall(f.close,f)
 s.bindingCleared=writeOk and cleared or false
 return writeOk
end
-- 客户端整张地图表：id:名称，逗号分隔。助手页面据此列出所有可巡回地图。
local function buildMapCatalog()
 local source=rawget(_G,'data_MapInfo')
 if type(source)~='table' then return '' end
 local ids={}
 for id in pairs(source) do if type(id)=='number' and id>0 then ids[#ids+1]=id end end
 table.sort(ids)
 local parts={}
 for _,id in ipairs(ids) do
  local entry=source[id]
  local name=entry and entry.name
  if type(name)=='string' and name~='' then
   SUPPORTED_MAPS[id]=true
   parts[#parts+1]=tostring(id)..':'..name:gsub('[,\n]',' ')
  end
 end
 return table.concat(parts,',')
end
-- 地图出生点：id:x:y。传送功能需要它才能跳到任意地图。
local function readMapValue(object,key)
 if type(object)~='table' then return nil end
 local ok,value=pcall(function() return object[key] end)
 if not ok or value==nil then return nil end
 if type(value)=='table' then return value[1] end
 return value
end
local function buildMapStarts()
 local source=rawget(_G,'data_MapInfo')
 if type(source)~='table' then return '' end
 local ids={}
 for id in pairs(source) do if type(id)=='number' and id>0 then ids[#ids+1]=id end end
 table.sort(ids)
 local parts={}
 for _,id in ipairs(ids) do
  local entry=source[id]
  local position=entry and entry.startPos
  if type(position)~='table' then
   local globalEntry=rawget(_G,'data_map_'..tostring(id))
   position=globalEntry and globalEntry.startPos
  end
  local x=tonumber(readMapValue(position,'x') or readMapValue(position,'posX'))
  local y=tonumber(readMapValue(position,'y') or readMapValue(position,'posY'))
  if not x then x=tonumber(position and position[1]) end
  if not y then y=tonumber(position and position[2]) end
  if x and y and x>0 and y>0 then parts[#parts+1]=tostring(id)..':'..tostring(x)..':'..tostring(y) end
 end
 return table.concat(parts,',')
end
local function buildMapDebug()
 local source=rawget(_G,'data_MapInfo')
 if type(source)~='table' then return '' end
 local out={}
 for _,map in ipairs({1002,1011}) do
  local ok,entry=pcall(function() return source[map] end)
  local desc='-'
  if ok and type(entry)=='table' then
   local pok,pos=pcall(function() return entry.startPos end)
   if pok and pos~=nil then
    desc=type(pos)
    if type(pos)=='table' then
     local parts={'#'..tostring(#pos)}
     pcall(function()
      for k,v in pairs(pos) do
       parts[#parts+1]=tostring(k)..'='..tostring(type(v)=='table' and ('tbl:'..tostring(v[1])) or v)
      end
     end)
     desc=desc..'('..table.concat(parts,' ')..')'
    else
     desc=desc..':'..tostring(pos)
    end
   end
  end
  out[#out+1]=tostring(map)..'='..desc
 end
 return table.concat(out,';')
end
local function writeStatus(s,state,reason)
 s.status=state
 if (s.mapCatalog==nil or s.mapCatalog=='') and type(rawget(_G,'data_MapInfo'))=='table' then
  s.mapCatalog=buildMapCatalog()
  s.mapStarts=buildMapStarts()
  s.mapDebug=buildMapDebug()
 end
 if reason~=nil then s.reason=reason else s.reason=s.reason or '' end
 local target=s.target
 local fields={
  {'status',s.status},
  {'mapCatalog',s.mapCatalog or ''},
  {'mapStarts',s.mapStarts or ''},
  {'mapDebug',s.mapDebug or ''},
  {'map',s.map},
  {'mapName',s.mapName},
  {'role',s.role},
  {'mapCounts',s.mapCounts},
  {'mapNames',s.mapNames},
  {'selectedMaps',s.selectedMaps},
  {'selectedMap',s.selectedMap},
  {'nextMap',s.pendingMap or (s.mapTarget and s.mapTarget.map) or 0},
  {'nextMapName',MAP_FALLBACK_NAMES[s.pendingMap or (s.mapTarget and s.mapTarget.map)] or ''},
  {'targetId',target and target.id or 'unknown'},
  {'targetName',target and target.name or 'unknown'},
  {'targetX',target and target.x or 'unknown'},
  {'targetY',target and target.y or 'unknown'},
  {'calls',s.calls},
  {'teleports',s.teleports},
  {'challenges',s.challenges},
  {'skipped',s.skipped},
  {'reason',s.reason},
  {'updatedAt',os.time()},
  {'hooksRemoved',s.hooksRemoved},
  {'bindingCleared',s.bindingCleared},
  {'acceptedSequence',s.acceptedSequence},
 }
 local ok,f=pcall(io.open,cfg.resultPath,'w')
 if not ok or not f then return false end
 local writeOk=pcall(function()
  for _,pair in ipairs(fields) do f:write(pair[1],'=',clean(pair[2]),'\n') end
 end)
 pcall(f.close,f)
 return writeOk
end
local function removeObserver(s)
 if not s.useHook then s.hooksRemoved=true;return true end
 if netconn and netconn.useFunc==s.useHook then
  netconn.useFunc=s.useOriginal
  s.hooksRemoved=netconn.useFunc==s.useOriginal
 else
  s.hooksRemoved=false
 end
 if s.hooksRemoved then s.useHook=nil;s.useOriginal=nil end
 return s.hooksRemoved
end
local function isStopRequested()
 return readFile(cfg.stopPath)~=nil
end
local function leaseAlive()
 if isStopRequested() then return false,'stop_requested' end
 local now=os.time()
 local allFresh=true
 local bothStale=true
 for _,path in ipairs({cfg.leasePath,cfg.workerPath}) do
  local value=readFile(path)
  local stamp=value and tonumber(value:match('%d+'))
  local fresh=stamp and now>=stamp and now-stamp<=5
  if fresh then bothStale=false else allFresh=false end
 end
 if allFresh then return true,nil,false end
 return false,'lease_expired',bothStale
end
local function copyCommand(command)
 local maps={}
 for index,map in ipairs(command.maps or {}) do maps[index]=map end
 return {sequence=command.sequence,mode=command.mode,maps=maps,selectedMap=command.selectedMap,map=command.map}
end
local function parseChallengeAction(buttons)
 if type(buttons)~='string' then return nil,'challenge_buttons_missing' end
 local allowed={['挑战']=true,['开始挑战']=true,['我要挑战']=true,['挑战boss']=true,['挑战boss！']=true,['挑战boss!']=true}
 local matches,guard,unknown={},false,false
 for item in (buttons..'|'):gmatch('(.-)|') do
  if item~='' then
   local label,action=item:match('^([^/]+)/([^/]*)$')
   if not label or action=='' then unknown=true
   else
    local normalized=label:match('^%s*(.-)%s*$'):lower()
    local actual=action:match('^%s*(.-)%s*$')
    if actual=='guard' then guard=true
    elseif actual=='离开' or actual=='' then
    elseif allowed[normalized] then matches[#matches+1]=actual
    else unknown=true end
   end
  end
 end
 if #matches==1 then return matches[1],nil end
 if #matches>1 then return nil,'ambiguous_challenge_buttons' end
 if guard and not unknown then return nil,'guard_only' end
 return nil,'challenge_button_not_confirmed'
end
local function anleiActionActive()
 return rawget(_G,'__codex_anlei_v1')~=nil
end
local function writeSkippedOnce(s,id,reason)
 local keyId=tostring(id)
 if not s.skippedTargets[keyId] then s.skipped=s.skipped+1;s.skippedTargets[keyId]=true end
 s.cooldowns[keyId]=s.elapsed+5
 s.reason=reason
end
local function clearAction(s)
 s.phase=nil
 s.phaseDeadline=nil
 s.teleportResponse=nil
 s.ownBattleResponse=false
 s.endBattleSeen=false
 s.challengeTargetMissingSince=nil
 s.challengeAction=nil
 s.target=nil
 s.mapTarget=nil
 s.mapResponse=nil
 s.pendingMap=nil
 s.pendingMapCursor=nil
end
local function resetRound(s)
 s.roundAttempted={}
 s.roundWaitUntil=nil
end
local pauseRun
local finish
local function applySelection(s,maps)
 s.selectedMapSet={}
 for _,map in ipairs(maps or {}) do s.selectedMapSet[map]=true end
 s.selectedMaps=selectedMapsCsv(maps)
 s.selectedMap=(maps and maps[1]) or 0
 s.mapOrder={}
 for _,map in ipairs(maps or {}) do s.mapOrder[#s.mapOrder+1]=map end
end
local function acceptCommand(s,command)
 s.acceptedSequence=command.sequence
 s.acceptedCommand=copyCommand(command)
 s.unknown=false
 s.paused=false
 s.reason=''
 clearAction(s)
 s.challengeSentRole=nil
 s.lateBattleResponseAt=nil
 if command.mode=='scan' then
  s.mode='scan'
  applySelection(s,command.maps)
  s.lockedMap=nil
  s.lockedRole=nil
  s.activeMap=nil;s.mapCursor=nil;s.pendingMap=nil;s.pendingMapCursor=nil
  removeObserver(s)
  writeBinding(s,true)
  return true
 end
 if command.mode=='teleport' then
  s.mode='teleport'
  s.teleportTarget=tonumber(command.map)
  s.teleportSent=false
  s.teleportDeadline=nil
  applySelection(s,command.maps)
  s.lockedMap=nil;s.lockedRole=nil
  s.activeMap=nil;s.mapCursor=nil;s.pendingMap=nil;s.pendingMapCursor=nil
  removeObserver(s)
  writeBinding(s,true)
  return true
 end
 s.mode='run'
 applySelection(s,command.maps)
 s.lockedMap=command.map
 s.lockedRole=nil
 s.activeMap=nil;s.mapCursor=nil;s.pendingMap=nil;s.pendingMapCursor=nil
 s.cursor=0
 s.cooldowns={}
 s.skippedTargets={}
 resetRound(s)
 if anleiActionActive() then
  pauseRun(s,'暗雷模块正在运行，请手动停止后重新开始')
  return true
 end
 if not s.hooksRemoved then removeObserver(s) end
 if not s.hooksRemoved or not s.useHook then
  if not netconn or type(netconn.useFunc)~='function' then
   s.unknown=true;s.reason='inbound_observer_unavailable';return false
  end
  local original=netconn.useFunc
  s.useOriginal=original
  s.useHook=function(self,id,data,...)
   if rawget(_G,key)==s and not s.finished then
    pcall(function()
     local changed=false
     if id==65505 and type(data)=='table' and s.phase=='teleport_wait' and s.target then
      local matches=tonumber(data.mapId)==s.target.map and tonumber(data.posX)==s.target.x and tonumber(data.posY)==s.target.y
      if matches then s.teleportResponse={map=data.mapId,x=data.posX,y=data.posY};changed=true end
     elseif id==65505 and type(data)=='table' and s.phase=='map_wait' and s.mapTarget then
      local matches=tonumber(data.mapId)==s.mapTarget.map and tonumber(data.posX)==s.mapTarget.x and tonumber(data.posY)==s.mapTarget.y
      if matches then s.mapResponse={map=data.mapId,x=data.posX,y=data.posY};changed=true end
     elseif id==3584 and type(data)=='table' and s.challengeSentRole and s.role and tostring(data.roleId)==tostring(s.role) then
      s.ownBattleResponse=true
      s.lateBattleResponseAt=s.elapsed
      changed=true
     elseif id==3581 then
      s.endBattleSeen=true;changed=true
     elseif id==8247 and type(data)=='table' and s.phase=='dialog_wait' and s.target and tostring(data.npcId)==tostring(s.target.id) then
      local action,why=parseChallengeAction(data.btns or data.buttons)
      if action then s.challengeAction=action;s.phase='challenge_ready';s.status='challenge_ready';s.phaseDeadline=nil;s.reason='challenge_button_confirmed'
      elseif why=='guard_only' then writeSkippedOnce(s,s.target.id,'仅提供观战入口');clearAction(s)
      else pauseRun(s,why or 'challenge_button_not_confirmed') end
      changed=true
     end
     if changed then writeStatus(s,s.status or 'reading',s.reason) end
    end)
   end
   return original(self,id,data,...)
  end
  netconn.useFunc=s.useHook
  s.hooksRemoved=false
 end
 writeBinding(s,false)
 return true
end
local function refreshCommand(s)
 local raw=readFile(cfg.commandPath)
 local command=parseCommand(raw)
 if not command then
  if s.mode=='run' then s.unknown=true;s.reason='command_unavailable_or_invalid' end
  return false,'command_unavailable_or_invalid'
 end
 if command.sequence<s.acceptedSequence then
  if s.mode=='run' then s.unknown=true;s.reason='command_sequence_regressed' end
  return false,'command_sequence_regressed'
 end
 if command.sequence==s.acceptedSequence then
  if s.acceptedCommand and not sameCommand(command,s.acceptedCommand) then
   if s.mode=='run' then s.unknown=true;s.reason='command_sequence_reused' end
   return false,'command_sequence_reused'
  end
  return true,'unchanged'
 end
 acceptCommand(s,command)
 return true,'updated'
end
local function getContext()
 local ok,context=pcall(function()
  local p=LocalPlayerMgr:getInstance()
  if not p then return nil,'waiting_role' end
  local role=p:getPlayerId()
  if not tonumber(role) or tonumber(role)<=0 then return nil,'waiting_role' end
  local manager=ClassIns and ClassIns['MapMgr.Ins']
  if not manager then return nil,'waiting_map' end
  local view=manager.m_MapView
  if not view then return nil,'waiting_map' end
  local map=tonumber(manager.m_CurMapId)
  local viewMap=tonumber(view.m_MapId)
  if not map or not viewMap or map~=viewMap then return nil,'waiting_map' end
  local player=view.m_LocalRole
  if not player or tonumber(player.m_PlayerId)~=tonumber(role) or player.m_IsLocalPlayer~=true then return nil,'waiting_role' end
  local mapName='unknown'
  local info=view.m_MapInfo
  if info and info.data_MapInfo and type(info.data_MapInfo.name)=='string' then mapName=info.data_MapInfo.name
  elseif info and type(info.name)=='string' then mapName=info.name
  elseif data_MapInfo and data_MapInfo[map] and type(data_MapInfo[map].name)=='string' then mapName=data_MapInfo[map].name end
  return {playerManager=p,role=role,manager=manager,view=view,map=map,mapName=mapName,loading=manager.m_IsMapLoading==true,x=tonumber(player.m_Gx),y=tonumber(player.m_Gy)}
 end)
 if not ok then return nil,'waiting_map' end
 return context
end
local readProperty
local function mapStartPosition(map)
 if not SUPPORTED_MAPS[map] then return nil end
 local candidates={}
 local ok,entry=pcall(function() return data_MapInfo and data_MapInfo[map] end)
 if ok and entry then candidates[#candidates+1]=readProperty(entry,'startPos') end
 local globalOk,globalEntry=pcall(function() return rawget(_G,'data_map_'..tostring(map)) end)
 if globalOk and globalEntry then candidates[#candidates+1]=readProperty(globalEntry,'startPos') end
 for _,position in ipairs(candidates) do
  if position then
   local x=tonumber(readProperty(position,'x') or readProperty(position,'posX')) or tonumber(position[1])
   local y=tonumber(readProperty(position,'y') or readProperty(position,'posY')) or tonumber(position[2])
   if x and y and x>0 and y>0 and x%1==0 and y%1==0 and x<=100000 and y<=100000 then return x,y end
  end
 end
 return nil
end
local function putCandidate(byId,info,sceneNpc,currentMap)
 if type(info)~='table' then return end
 local ok,candidate=pcall(function()
  local title=info.title
  local name=info.name
  if type(title)~='string' then title='' end
  if type(name)~='string' then name='' end
  if not (name:lower():find('boss',1,true) or title:lower():find('boss',1,true)) then return nil end
  local roleId=info.roleId
  local mapId=info.mapId
  local posX=info.posX
  local posY=info.posY
  local id=tonumber(roleId)
  local map=tonumber(mapId)
  local x=tonumber(posX)
  local y=tonumber(posY)
  if not id or id<=0 or map~=currentMap or not SUPPORTED_MAPS[map] or not x or not y or x<=0 or y<=0 or x%1~=0 or y%1~=0 then return nil end
  return {id=id,map=map,x=x,y=y,name=name~='' and name or title,title=title,scene=sceneNpc}
 end)
 if not ok or not candidate then return end
 local keyId=tostring(candidate.id)
 local prior=byId[keyId]
 if not prior or sceneNpc then byId[keyId]=candidate end
end
readProperty=function(object,key)
 local ok,value=pcall(function() return object[key] end)
 if ok then return value end
 return nil
end
local function scanTargets(context,selectedMapSet)
 local byId={}
 local ok=pcall(function()
  for _,source in pairs({readProperty(context.manager,'m_DynamicNPC'),readProperty(context.manager,'m_CurMapFarNpc')}) do
   if type(source)=='table' then
    for _,entry in pairs(source) do
     local entryType=type(entry)
     if entryType=='table' or entryType=='userdata' then
      local info=readProperty(entry,'m_NpcInfo')
      putCandidate(byId,info or entry,nil,context.map)
     end
    end
   end
  end
  local sceneNpcs=readProperty(context.view,'m_NPC')
  if type(sceneNpcs)=='table' then
   for _,npc in pairs(sceneNpcs) do
    local npcType=type(npc)
    if npcType=='table' or npcType=='userdata' then
     putCandidate(byId,readProperty(npc,'m_NpcInfo'),npc,context.map)
    end
   end
  end
 end)
 if not ok then return nil end
 local count=0
 for _ in pairs(byId) do count=count+1 end
 local candidates={}
 for _,candidate in pairs(byId) do if selectedMapSet and selectedMapSet[candidate.map] then candidates[#candidates+1]=candidate end end
 table.sort(candidates,function(a,b) return a.id<b.id end)
 return byId,candidates,count
end
local function sceneFight(candidate)
 local npc=candidate and candidate.scene
 if not npc then return nil end
 local accessOk,getIsFight=pcall(function() return npc.getIsFight end)
 if not accessOk then return 'unknown' end
 if type(getIsFight)~='function' then return nil end
 local ok,fighting=pcall(getIsFight,npc)
 if not ok then return 'unknown' end
 return fighting==true
end
local function observeMap(s,context)
 if context then
  s.map=context.map;s.mapName=context.mapName;s.role=context.role;s.manager=tostring(context.manager)
 end
 local byId,candidates,count
 if context then byId,candidates,count=scanTargets(context,s.selectedMapSet) end
 if byId then
  s.targetsById=byId;s.candidates=candidates
  s.mapCounts=tostring(context.map)..':'..tostring(count)
  s.mapNames=tostring(context.map)..':'..clean(context.mapName)
 else
  s.targetsById={};s.candidates={};s.mapCounts='';s.mapNames=''
 end
end
local function enterUnknown(s,reason)
 s.unknown=true;s.reason=reason;s.phase='unknown';s.phaseDeadline=nil
end
pauseRun=function(s,reason)
 s.paused=true;s.reason=reason
 clearAction(s)
 removeObserver(s)
 writeBinding(s,true)
end
local function markFight(s,candidate)
 writeSkippedOnce(s,candidate.id,'客户端显示战斗中')
end
local function chooseTarget(s)
 local candidates=s.candidates or {}
 local total=#candidates
 if total==0 then return nil end
 local now=s.elapsed
 for offset=1,total do
  local index=((s.cursor+offset-1)%total)+1
  local candidate=candidates[index]
  local keyId=tostring(candidate.id)
  local cooldown=s.cooldowns[keyId] or 0
  if not (s.roundAttempted and s.roundAttempted[keyId]) and now>=cooldown then
   s.roundAttempted=s.roundAttempted or {}
   s.roundAttempted[keyId]=true
   local fighting=sceneFight(candidate)
   if fighting==true then
    markFight(s,candidate)
   elseif fighting=='unknown' then
    writeSkippedOnce(s,candidate.id,'客户端忙碌状态无法确认')
   else
    s.cursor=index
    return candidate
   end
  end
 end
 return nil
end
local function freshCandidate(s,id)
 local numericId=tonumber(id)
 if not numericId then return nil end
 local candidate=s.targetsById and s.targetsById[tostring(numericId)]
 if not candidate or not (s.selectedMapSet and s.selectedMapSet[candidate.map]) or candidate.map~=s.activeMap then return nil end
 return candidate
end
local function currentPositionMatches(context,target)
 return context and target and context.map==target.map and context.x==target.x and context.y==target.y
end
local function validateBeforeSend(s,stage)
 if s.finished or rawget(_G,key)~=s then return nil end
 if isStopRequested() then s.reason='worker_stop_requested';writeStatus(s,'stopping',s.reason);return nil end
 local alive,why=leaseAlive()
 if not alive then s.reason=why;writeStatus(s,'stopping',why);return nil end
 local commandOk,commandState=refreshCommand(s)
 if not commandOk or commandState=='updated' then return nil end
 if s.mode~='run' or s.paused or s.unknown then return nil end
 if anleiActionActive() then
  pauseRun(s,'暗雷模块正在运行，请手动停止后重新开始')
  return nil
 end
 if s.hooksRemoved or not s.useHook or not netconn or netconn.useFunc~=s.useHook then
  enterUnknown(s,'inbound_observer_ownership_lost');return nil
 end
 local context,contextState=getContext()
 if not context then writeStatus(s,contextState or 'waiting_role',contextState);return nil end
 observeMap(s,context)
 if context.loading then writeStatus(s,'waiting_map','map_loading');return nil end
 local warOk,inWar=pcall(JudgeIsInWar)
 if not warOk then writeStatus(s,'waiting_role','battle_state_unavailable');return nil end
 if inWar then enterUnknown(s,'battle_state_changed_before_send');return nil end
 if not netconn or netconn.m_ConnectState~=1 then writeStatus(s,'waiting_role','network_not_connected');return nil end
 if not s.lockedRole then
  if context.map~=s.lockedMap then pauseRun(s,'start_map_changed');return nil end
  s.lockedRole=context.role;s.role=context.role;s.manager=tostring(context.manager)
  if not writeBinding(s,false) then enterUnknown(s,'binding_write_failed');return nil end
 end
 if tostring(context.role)~=tostring(s.lockedRole) then pauseRun(s,'role_changed');return nil end
 if stage~='map' and context.map~=s.activeMap then pauseRun(s,'unexpected_map_before_send');return nil end
 local permissionOk,teamRestricted=pcall(function()
  local value=readProperty(context.manager,'canNotOperationTeam')
  if type(value)=='function' then return value(context.manager) end
  return value
 end)
 if not permissionOk or type(teamRestricted)~='boolean' then writeStatus(s,'waiting_role','team_operation_state_unavailable');return nil end
 if teamRestricted then pauseRun(s,'team_operation_restricted');return nil end
 if stage=='map' then return nil,context end
 if stage=='challenge' and not currentPositionMatches(context,s.target) then
  enterUnknown(s,'challenge_position_changed_after_confirmation');writeStatus(s,'unknown',s.reason);return nil
 end
 local target=freshCandidate(s,s.target and s.target.id)
 if not target then
  if stage=='challenge' and s.phase=='challenge_ready' then
   s.challengeTargetMissingSince=s.challengeTargetMissingSince or s.elapsed
   if s.elapsed-s.challengeTargetMissingSince>=CHALLENGE_REBIND_GRACE then
    enterUnknown(s,'challenge_target_rebinding_timeout')
    writeStatus(s,'unknown',s.reason)
   else
    writeStatus(s,'waiting_targets','challenge_target_rebinding')
   end
   return nil
  end
  clearAction(s);writeStatus(s,'waiting_targets','target_instance_missing');return nil
 end
 s.challengeTargetMissingSince=nil
 if stage=='challenge' then
  if target.x~=s.target.x or target.y~=s.target.y then
   enterUnknown(s,'challenge_target_position_changed_after_confirmation')
   writeStatus(s,'unknown',s.reason)
   return nil
  end
  s.target=target
 end
 local fighting=sceneFight(target)
 if fighting==true then
  markFight(s,target);clearAction(s);writeStatus(s,'waiting_targets',s.reason);return nil
 elseif fighting=='unknown' then
  writeSkippedOnce(s,target.id,'客户端忙碌状态无法确认')
  clearAction(s);writeStatus(s,'waiting_targets',s.reason);return nil
 end
 return target,context
end
local function sendTeleport(s)
 local target,context=validateBeforeSend(s,'teleport')
 if not target then return false end
 if not tonumber(C2S_JumpMap) or tonumber(C2S_JumpMap)~=22568 then enterUnknown(s,'teleport_protocol_unconfirmed');return false end
 if target.x%1~=0 or target.y%1~=0 then enterUnknown(s,'target_position_not_integer');return false end
 local latest=freshCandidate(s,target.id)
 if not latest then clearAction(s);return false end
 target=latest;s.target=target
 s.calls=s.calls+1;s.teleports=s.teleports+1;s.phase='teleport_wait';s.phaseDeadline=s.elapsed+8;s.teleportResponse=nil
 local ok,err=pcall(netconn.send,netconn,C2S_JumpMap,context.map,target.x,target.y,0)
 if not ok then enterUnknown(s,'teleport_send_failed:'..clean(err));return false end
 writeStatus(s,'teleport_wait','awaiting_position_confirmation')
 return true
end
local function sendMapTransition(s,map)
 local _,context=validateBeforeSend(s,'map')
 if not context then return false end
 if not (s.selectedMapSet and s.selectedMapSet[map]) then return false end
 local x,y=mapStartPosition(map)
 if not x or not y then pauseRun(s,'map_start_position_unavailable:'..tostring(map));return false end
 if not tonumber(C2S_JumpMap) or tonumber(C2S_JumpMap)~=22568 then enterUnknown(s,'teleport_protocol_unconfirmed');return false end
 s.mapTarget={map=map,x=x,y=y};s.mapResponse=nil;s.phase='map_wait';s.phaseDeadline=s.elapsed+MAP_WAIT_SECONDS
 s.calls=s.calls+1;s.teleports=s.teleports+1
 local ok,err=pcall(netconn.send,netconn,C2S_JumpMap,map,x,y,0)
 if not ok then enterUnknown(s,'map_transition_send_failed:'..clean(err));return false end
 writeStatus(s,'map_wait','awaiting_map_confirmation')
 return true
end
local function requestChallengeButtons(s)
 local target,context=validateBeforeSend(s,'challenge')
 if not target then return false end
 if not tonumber(C2S_ReqNPCBtns) or tonumber(C2S_ReqNPCBtns)~=3520 then enterUnknown(s,'npc_buttons_protocol_unconfirmed');return false end
 s.phase='dialog_wait';s.phaseDeadline=s.elapsed+DIALOG_WAIT_SECONDS;s.challengeAction=nil
 s.calls=s.calls+1
 local ok,err=pcall(netconn.send,netconn,C2S_ReqNPCBtns,target.id,1)
 if not ok then enterUnknown(s,'npc_buttons_request_failed:'..clean(err));return false end
 writeStatus(s,'dialog_wait','awaiting_npc_buttons')
 return true
end
local function sendChallenge(s)
 local target=validateBeforeSend(s,'challenge')
 if not target then return false end
 if not tonumber(C2S_TouchNPCBtn) or tonumber(C2S_TouchNPCBtn)~=12344 or type(s.challengeAction)~='string' or s.challengeAction=='' then enterUnknown(s,'challenge_action_unconfirmed');return false end
 s.calls=s.calls+1;s.challenges=s.challenges+1;s.phase='challenge_wait';s.phaseDeadline=s.elapsed+12;s.ownBattleResponse=false
 s.challengeSentRole=s.lockedRole
 local ok,err=pcall(netconn.send,netconn,C2S_TouchNPCBtn,target.id,s.challengeAction,'')
 if not ok then enterUnknown(s,'challenge_send_failed:'..clean(err));return false end
 writeStatus(s,'challenge_wait','awaiting_own_battle_confirmation')
 return true
end
-- 直接传送：只发一次地图跳转，确认到达或超时后结束，不扫描也不挑战。
local function mapStartPositionAny(map)
 local source=rawget(_G,'data_MapInfo')
 local entry=source and source[map]
 local position=entry and entry.startPos
 if type(position)~='table' then
  local globalEntry=rawget(_G,'data_map_'..tostring(map))
  position=globalEntry and globalEntry.startPos
 end
 local x=position and (position.x or position[1] or position.posX)
 local y=position and (position.y or position[2] or position.posY)
 x=tonumber(x);y=tonumber(y)
 if x and y and x>0 and y>0 and x%1==0 and y%1==0 and x<=100000 and y<=100000 then return x,y end
 return nil
end
local function teleportStep(s,context,contextState)
 if s.finished or rawget(_G,key)~=s or s.paused or s.unknown then return end
 if isStopRequested() then writeStatus(s,'stopping','worker_stop_requested');return end
 local alive,why=leaseAlive()
 if not alive then writeStatus(s,'stopping',why);return end
 if anleiActionActive() then finish(s,'other_movement_active');return end
 if not context then writeStatus(s,contextState or 'waiting_role',contextState);return end
 if context.loading then writeStatus(s,'waiting_map','map_loading');return end
 if not s.lockedRole then
  s.lockedRole=context.role;s.role=context.role;s.manager=tostring(context.manager)
  if not writeBinding(s,false) then finish(s,'binding_write_failed');return end
 elseif tostring(context.role)~=tostring(s.lockedRole) then finish(s,'role_changed');return end
 local warOk,inWar=pcall(JudgeIsInWar)
 if not warOk or inWar then writeStatus(s,'waiting_role','battle_state_unavailable_or_active');return end
 if not netconn or netconn.m_ConnectState~=1 then writeStatus(s,'waiting_role','network_not_connected');return end
 local permissionOk,teamRestricted=pcall(function()
  local value=readProperty(context.manager,'canNotOperationTeam')
  if type(value)=='function' then return value(context.manager) end
  return value
 end)
 if not permissionOk or type(teamRestricted)~='boolean' or teamRestricted then
  writeStatus(s,'waiting_role','team_operation_restricted_or_unknown');return
 end
 if not context then writeStatus(s,contextState or 'waiting_role',contextState);return end
 if context.loading then writeStatus(s,'waiting_map','map_loading');return end
 if tonumber(context.map)==tonumber(s.teleportTarget) then finish(s,'teleported');return end
 if s.teleportSent then
  if s.elapsed>=(s.teleportDeadline or math.huge) then
   writeStatus(s,'unknown','teleport_timeout')
   finish(s,'teleport_timeout')
  else
   writeStatus(s,'teleport_wait','awaiting_map_confirmation')
  end
  return
 end
 local x,y=mapStartPositionAny(s.teleportTarget)
 if not x or not y then
  writeStatus(s,'unknown','map_start_position_unavailable')
  finish(s,'map_start_position_unavailable')
  return
 end
 if not tonumber(C2S_JumpMap) or tonumber(C2S_JumpMap)~=22568 then
  enterUnknown(s,'teleport_protocol_unconfirmed')
  writeStatus(s,'unknown',s.reason)
  return
 end
 s.teleportSent=true;s.teleportDeadline=s.elapsed+MAP_WAIT_SECONDS+2
 s.calls=s.calls+1;s.teleports=s.teleports+1
 local ok=pcall(netconn.send,netconn,C2S_JumpMap,s.teleportTarget,x,y,0)
 if not ok then
  writeStatus(s,'unknown','teleport_send_failed')
  finish(s,'teleport_send_failed')
  return
 end
 writeStatus(s,'teleport_wait','jump_sent')
end
local function tick(s,dt)
 if rawget(_G,key)~=s or s.finished then return end
 s.elapsed=s.elapsed+(type(dt)=='number' and math.max(0,dt) or SCAN_INTERVAL_SECONDS)
 local alive,leaseReason,bothStale=leaseAlive()
 if alive then
  s.leaseStaleSince=nil
 elseif leaseReason=='lease_expired' and bothStale then
  s.leaseStaleSince=s.leaseStaleSince or s.elapsed
  if s.elapsed-s.leaseStaleSince>=LEASE_STALE_GRACE then
   refreshCommand(s)
   finish(s,'lease_expired')
   return
  end
 else
  s.leaseStaleSince=nil
 end
 local commandOk,commandState=refreshCommand(s)
 if not commandOk then
  local state=s.mode=='run' and 'unknown' or 'reading'
  writeStatus(s,state,s.reason~='' and s.reason or commandState)
  return
 end
 local context,contextState=getContext()
 observeMap(s,context)
 if s.mode=='teleport' then teleportStep(s,context,contextState);return end
 if s.mode=='scan' then writeStatus(s,'reading','');return end
 if s.paused then writeStatus(s,'paused',s.reason);return end
 local warOk,inWar=pcall(JudgeIsInWar)
 if not warOk then writeStatus(s,'waiting_role','battle_state_unavailable');return end
 if s.phase=='battle' then
  if s.endBattleSeen and not inWar and context and not context.loading then
   if tostring(context.role)~=tostring(s.lockedRole) then pauseRun(s,'role_changed_after_battle')
   elseif context.map~=s.activeMap then pauseRun(s,'map_changed_after_battle')
   else clearAction(s);s.unknown=false;s.paused=false;s.reason='';writeBinding(s,false);writeStatus(s,'reading','battle_ended') end
  else writeStatus(s,'battle','waiting_for_battle_end') end
  return
 end
 if inWar then
  if s.ownBattleResponse and context and tostring(context.role)==tostring(s.lockedRole) then
   s.phase='battle';s.phaseDeadline=nil;writeStatus(s,'battle','own_start_battle_confirmed')
  else enterUnknown(s,'battle_without_matching_confirmation');writeStatus(s,'unknown',s.reason) end
  return
 end
 if s.ownBattleResponse and s.lateBattleResponseAt then
  if s.elapsed-s.lateBattleResponseAt>=CHALLENGE_REBIND_GRACE then
   enterUnknown(s,'battle_confirmation_unresolved');writeStatus(s,'unknown',s.reason)
  else writeStatus(s,'challenge_wait','own_battle_response_pending') end
  return
 end
 if s.unknown then writeStatus(s,'unknown',s.reason);return end
 if anleiActionActive() then pauseRun(s,'暗雷模块正在运行，请手动停止后重新开始');writeStatus(s,'paused',s.reason);return end
 if not context then writeStatus(s,contextState or 'waiting_role',contextState);return end
 if context.loading then writeStatus(s,'waiting_map','map_loading');return end
 if not s.lockedRole then
  if context.map~=s.lockedMap then pauseRun(s,'start_map_changed');writeStatus(s,'paused',s.reason);return end
  s.lockedRole=context.role;s.role=context.role;s.manager=tostring(context.manager)
  if not writeBinding(s,false) then enterUnknown(s,'binding_write_failed');writeStatus(s,'unknown',s.reason);return end
 end
 if tostring(context.role)~=tostring(s.lockedRole) then pauseRun(s,'role_changed');writeStatus(s,'paused',s.reason);return end
 if s.phase=='map_wait' then
  local transitionSource=s.activeMap or s.lockedMap
  if context.map~=transitionSource and context.map~=s.mapTarget.map then pauseRun(s,'unexpected_map_during_transition');writeStatus(s,'paused',s.reason);return end
  if s.mapResponse and context.map==s.mapTarget.map and not context.loading then
   s.activeMap=s.mapTarget.map;s.mapCursor=s.mapTarget.cursor or s.mapCursor;s.mapTarget=nil;s.mapResponse=nil;s.phase=nil;s.phaseDeadline=nil
   resetRound(s);s.cursor=0;writeStatus(s,'reading','map_transition_confirmed')
  elseif s.elapsed>=(s.phaseDeadline or math.huge) then enterUnknown(s,'map_transition_confirmation_timeout');writeStatus(s,'unknown',s.reason)
  else writeStatus(s,'map_wait',s.mapResponse and 'map_context_pending' or 'awaiting_map_confirmation') end
  return
 end
 if not s.activeMap then
  if s.selectedMapSet[context.map] then
   s.activeMap=context.map
   for index,map in ipairs(s.mapOrder) do if map==context.map then s.mapCursor=index;break end end
  else
   local first=s.mapOrder[1]
   if not first then writeStatus(s,'waiting_targets','no_maps_selected');return end
   s.mapCursor=1
   sendMapTransition(s,first)
   return
  end
 end
 if context.map~=s.activeMap then pauseRun(s,'unexpected_map_change');writeStatus(s,'paused',s.reason);return end
 if s.pendingMap then
  if s.roundWaitUntil and s.elapsed<s.roundWaitUntil then writeStatus(s,'cooldown','map_round_cooldown');return end
  local pending=s.pendingMap
  s.pendingMap=nil;s.roundWaitUntil=nil;s.mapCursor=s.pendingMapCursor or s.mapCursor;s.pendingMapCursor=nil
  resetRound(s);s.cursor=0
  if pending~=s.activeMap then sendMapTransition(s,pending);return end
 end
 if s.phase=='teleport_wait' then
  if s.teleportResponse and currentPositionMatches(context,s.target) then
   s.phase='challenge_ready';s.phaseDeadline=nil;writeStatus(s,'challenge_ready','position_confirmed')
  elseif s.elapsed>=(s.phaseDeadline or math.huge) then enterUnknown(s,'teleport_confirmation_timeout');writeStatus(s,'unknown',s.reason)
  else writeStatus(s,'teleport_wait',s.teleportResponse and 'position_update_pending' or 'awaiting_position_confirmation') end
  return
 end
 if s.phase=='challenge_ready' then
  if s.challengeAction then sendChallenge(s) else requestChallengeButtons(s) end
  return
 end
 if s.phase=='dialog_wait' then
  if s.elapsed>=(s.phaseDeadline or math.huge) then
   writeSkippedOnce(s,s.target and s.target.id or 'unknown','NPC挑战按钮响应超时');clearAction(s);writeStatus(s,'waiting_targets',s.reason)
  else writeStatus(s,'dialog_wait','awaiting_npc_buttons') end
  return
 end
 if s.phase=='challenge_wait' then
  if s.elapsed>=(s.phaseDeadline or math.huge) then
   writeSkippedOnce(s,s.target and s.target.id or 'unknown','挑战未获自身战斗确认');clearAction(s);writeStatus(s,'waiting_targets',s.reason)
  else writeStatus(s,'challenge_wait','awaiting_own_battle_confirmation') end
  return
 end
 if s.roundWaitUntil and s.elapsed<s.roundWaitUntil then writeStatus(s,'cooldown','map_round_cooldown');return end
 if s.roundWaitUntil and s.elapsed>=s.roundWaitUntil then resetRound(s);s.cursor=0;s.roundWaitUntil=nil end
 local target=chooseTarget(s)
 if target then s.target=target;sendTeleport(s);return end
 local nextCursor=(s.mapCursor or 1)+1
 if nextCursor>#s.mapOrder then
  nextCursor=1
  if #s.mapOrder==1 then resetRound(s);s.cursor=0;s.roundWaitUntil=s.elapsed+MAP_ROTATION_COOLDOWN
  else s.pendingMap=s.mapOrder[nextCursor];s.pendingMapCursor=nextCursor;s.roundWaitUntil=s.elapsed+MAP_ROTATION_COOLDOWN;writeStatus(s,'cooldown','map_round_cooldown');return end
 end
 if #s.mapOrder==1 then writeStatus(s,'cooldown','map_round_cooldown');return end
 s.mapCursor=nextCursor
 if s.mapOrder[nextCursor]~=s.activeMap then sendMapTransition(s,s.mapOrder[nextCursor]);return end
 resetRound(s);s.cursor=0
 writeStatus(s,'waiting_targets','no_boss_candidates_refresh')
end
finish=function(s,reason)
 if s.finished then return end
 s.finished=true
 if s.timer then pcall(scheduler.unscheduleGlobal,s.timer);s.timer=nil end
 removeObserver(s)
 clearAction(s)
 writeBinding(s,true)
 writeStatus(s,'stopped',reason or '')
 if rawget(_G,key)==s then rawset(_G,key,nil) end
end
local function freshState()
 local initial=tonumber(cfg.baselineSequence) or 0
 local baseline=parseCommand(readFile(cfg.commandPath))
 local s={
  runId=cfg.runId,elapsed=0,acceptedSequence=initial,acceptedCommand=nil,
  mode='scan',selectedMaps='',selectedMap=0,selectedMapSet={},mapOrder={},mapCursor=nil,lockedMap=nil,lockedRole=nil,activeMap=nil,role='unknown',manager='unknown',
  map='unknown',mapName='unknown',mapCounts='',mapNames='',targetsById={},candidates={},
  target=nil,phase=nil,phaseDeadline=nil,teleportResponse=nil,ownBattleResponse=false,
  endBattleSeen=false,calls=0,teleports=0,challenges=0,skipped=0,
  cooldowns={},skippedTargets={},cursor=0,unknown=false,paused=false,reason='',
  hooksRemoved=true,bindingCleared=true,finished=false,
 }
 if baseline and baseline.sequence==initial then s.acceptedCommand=copyCommand(baseline) end
 return s
end
local function resultWithoutState(status,reason)
 local command=parseCommand(readFile(cfg.commandPath))
 local s=freshState()
 if command and command.sequence>(tonumber(cfg.baselineSequence) or 0) then s.acceptedSequence=command.sequence end
 s.reason=reason or ''
 writeStatus(s,status,s.reason)
end
if cfg.mode=='stop' then
 local s=rawget(_G,key)
 if s and s.runId==cfg.runId then
  local accepted,why=refreshCommand(s)
  if accepted then finish(s,'worker_stop')
  else finish(s,'worker_stop_command_unconfirmed:'..clean(why)) end
 elseif s then resultWithoutState('stopping','foreign_lua_state')
 else resultWithoutState('stopped','nothing_owned') end
 return 0
end
local existing=rawget(_G,key)
if existing then
 if existing.runId==cfg.runId then return 0 end
 writeStatus(existing,'stopping','prior_run_cleanup_required')
 return 0
end
local s=freshState()
rawset(_G,key,s)
if not writeBinding(s,true) then enterUnknown(s,'binding_clear_failed') end
local commandOk,commandState=refreshCommand(s)
if commandState=='updated' and s.mode=='run' then
 -- A post-baseline command is an explicit operator action and may start this session.
end
local context=getContext()
observeMap(s,context)
local function scheduled(dt)
 local ok,err=pcall(tick,s,dt)
 if not ok and not s.finished then enterUnknown(s,'state_machine_error:'..clean(err));writeStatus(s,'unknown',s.reason) end
end
s.timer=scheduler.scheduleGlobal(scheduled,SCAN_INTERVAL_SECONDS)
if s.unknown then writeStatus(s,'unknown',s.reason)
elseif s.mode=='run' and not s.hooksRemoved then writeStatus(s,'waiting_role','awaiting_role_and_map')
else writeStatus(s,'reading',commandOk and '' or commandState) end
return 0
